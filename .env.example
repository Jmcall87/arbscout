# Operating mode: research | semi | full
ARBSCOUT_MODE=research

# Comma-separated venue IDs permitted to transact. Empty = none.
ARBSCOUT_ALLOWED_VENUES=

# Safety limits for execution.
ARBSCOUT_MAX_SPEND_PER_TRADE=50
ARBSCOUT_MAX_SPEND_PER_DAY=200
ARBSCOUT_KILL_SWITCH=true
ARBSCOUT_TOS_ACK=false

# Scanning.
ARBSCOUT_SCAN_INTERVAL_SECONDS=300
ARBSCOUT_MIN_NET_PROFIT=0.50
ARBSCOUT_MIN_ROI_PCT=0.5
ARBSCOUT_MIN_CONFIDENCE=0.45
ARBSCOUT_PAYMENT_SPREAD_PCT=0

# Storage.
ARBSCOUT_DB_PATH=/app/data/arbscout.db
ARBSCOUT_HISTORY_LIMIT=200
